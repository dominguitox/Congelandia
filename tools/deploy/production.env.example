APP_NAME=Congelandia
APP_ENV=production
# Generar una sola vez en el PC con: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.cl
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
# Sistema visual: congelandia o md3. Paleta: base, esmeralda, aurora o coral.
APP_TEMA=congelandia
APP_COLOR=base

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usuario_congelandia
DB_USERNAME=usuario_congelandia
DB_PASSWORD="REEMPLAZAR"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

PUBLIC_TELEFONO="+56 9 1234 5678"
PUBLIC_WHATSAPP=56912345678
PUBLIC_EMAIL=contacto@congelandia.cl
PUBLIC_DIRECCION="Santiago, Chile"
PUBLIC_HORARIO="Lunes a sábado, 10:00 a 20:00"
PUBLIC_ESTILO=hielo
PUBLIC_SELECTOR_ESTILOS=false
